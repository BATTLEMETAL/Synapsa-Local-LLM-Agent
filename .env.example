# Synapsa — Przykładowy plik konfiguracyjny
# Skopiuj jako .env i uzupełnij własnymi danymi:
#   cp .env.example .env
#
# NIE COMMITUJ .env do git — jest w .gitignore.

# --- API KEYS (Opcjonalne — tylko dla trybu chmury) ---
# Gemini API: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API: https://console.groq.com/keys
GROQ_API_KEY=

# --- MODEL (domyślny dla RTX 3060 12GB) ---
MODEL_PATH=unsloth/Qwen2.5-Coder-7B-Instruct-bnb-4bit
ADAPTER_PATH=moje_ai_adaptery

# --- HARDWARE (generowane automatycznie przez: python -m synapsa.hardware) ---
# Możliwe wartości DEVICE: cuda / cpu
DEVICE=cuda
MAX_SEQ_LENGTH=4096
BNB_CPU_OFFLOAD=1

# --- PATHS ---
# Katalog projektu do skanowania (dla agent.py)
PROJECT_SCAN_PATH=
ANDROID_SCAN_PATH=

# --- WINDOWS COMPAT ---
XFORMERS_FORCE_DISABLE_TRITON=1
WBITS_USE_TRITON=0

# --- PYTHON ENCODING (fix dla emoji w konsoli Windows) ---
PYTHONUTF8=1
PYTHONIOENCODING=utf-8
